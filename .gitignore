# Root build output (go build -o bin/ ./cmd/..., or a plain go build). Each part keeps its own .gitignore.
/bin/
/deploybot-server
/deploybot
/bot-api-server
/bot-mcp-server
/cmd/*/deploybot-server
/cmd/*/deploybot
*.test
*.out
.env
.env.*
!.env.example

# Skill Forge registry skills: the Project environment installs them in threads; `skf sync` writes them locally
/.agents/skills/*
!/.agents/skills/deploybot-api-change/
!/.agents/skills/deploybot-mcp-tool/
/dist/
